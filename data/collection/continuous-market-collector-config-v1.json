{
  "schema_version": 1,
  "model": "continuous-market-collector-config-v1",
  "enabled": true,
  "product_id": "2026-topps-chrome-premier-league",
  "format_id": "hobby",
  "observation_file": "data/collection/2026-topps-chrome-premier-league-market-observations-v1.json",
  "automated_valuation_file": "data/derived/2026-topps-chrome-premier-league-hobby-automated-valuation-candidates-v1.json",
  "fast_lane": {
    "provider": "sportscardspro-api",
    "cadence_minutes": 15,
    "batch_size": 20,
    "min_request_interval_ms": 1100,
    "max_tasks_per_subject_per_batch": 2,
    "credential_env": "SPORTSCARDSPRO_TOKEN",
    "persist_cursor": true,
    "fairness_mode": "team-then-subject-round-robin",
    "max_tasks_per_team_per_batch": 2,
    "priority_queue_slots": 10,
    "standard_fairness_slots": 10,
    "priority_queue_max_tasks_per_team": 3,
    "priority_queue_max_tasks_per_subject": 2
  },
  "bulk_lane": {
    "provider": "sportscardspro-csv",
    "cadence_hours": 24,
    "csv_url_env": "SPORTSCARDSPRO_CSV_URL",
    "credential_note": "Use the subscriber-specific Download Price List URL. The URL must be stored as a GitHub Actions secret.",
    "optional": true
  },
  "safety": {
    "exact_identity_required": true,
    "allow_cross_series_match": false,
    "current_provider_price_is_realized_sale": false,
    "current_provider_price_is_original_marketplace_verified": false,
    "auto_promote_modeled_values_to_canonical_ev": false,
    "priority_queue_is_not_valuation": true
  },
  "task_sources": {
    "inventory": "data/derived/2026-topps-chrome-premier-league-hobby-ev-eligible-inventory-v1.json",
    "provenance": "data/derived/2026-topps-chrome-premier-league-hobby-ev-contribution-provenance-v1.json",
    "base_odds": "data/odds/2026-topps-chrome-premier-league-hobby-base.json",
    "insert_odds_mapping": "data/mappings/2026-topps-chrome-premier-league-hobby-insert-odds-map.json",
    "autograph_odds_mapping": "data/mappings/2026-topps-chrome-premier-league-hobby-autograph-odds-map.json",
    "insert_checklist": "data/checklists/2026-topps-chrome-premier-league-hobby-inserts.json",
    "main_autographs": "data/checklists/2026-topps-chrome-premier-league-chrome-autographs.json",
    "special_autographs": "data/checklists/2026-topps-chrome-premier-league-hobby-special-autographs.json",
    "format": "data/formats/2026-topps-chrome-premier-league.json"
  },
  "scope": {
    "mode": "full-release-unvalued-slots",
    "eligible_slot_denominator": 8896,
    "current_valued_slots_are_excluded": true,
    "team_filter": null
  },
  "telemetry": {
    "state_file": "ops/collector/state-v1.json",
    "runs_file": "ops/collector/runs-v1.json",
    "metrics_file": "ops/collector/metrics-v1.json",
    "coverage_file": "ops/collector/coverage-v1.json",
    "exceptions_file": "ops/collector/exceptions-v1.json",
    "price_history_file": "ops/collector/price-history-v1.json",
    "quarantine_file": "ops/collector/quarantine-v1.json",
    "soak_file": "ops/collector/soak-v1.json",
    "acceptance_file": "ops/collector/acceptance-v1.json",
    "run_history_limit": 192,
    "exception_history_limit": 500,
    "price_history_limit_per_task": 50,
    "stale_fast_lane_minutes": 45,
    "stale_bulk_lane_hours": 36,
    "missing_match_exception_streak": 3,
    "degraded_provider_error_rate": 0.25,
    "priority_metrics": [
      "priority_tasks_checked",
      "priority_exact_matches",
      "priority_provider_prices",
      "priority_queue_coverage_pct"
    ]
  },
  "retry": {
    "max_attempts": 3,
    "base_delay_ms": 750,
    "max_delay_ms": 8000,
    "retry_http_statuses": [
      429,
      500,
      502,
      503,
      504
    ]
  },
  "quality": {
    "min_price_usd": 0.01,
    "max_price_usd": 1000000,
    "max_price_change_ratio": 10,
    "quarantine_extreme_price_changes": true,
    "require_positive_expected_copies_for_priority": true
  },
  "acceptance": {
    "soak_hours": 24,
    "min_successful_live_fast_runs": 72,
    "min_distinct_tasks_checked": 500,
    "min_exact_provider_matches": 1,
    "max_provider_error_rate": 0.15,
    "require_fast_lane_live": true,
    "bulk_lane_required": false,
    "require_canonical_ev_unchanged": true,
    "require_public_sharing_approval": true
  },
  "licensing": {
    "provider": "SportsCardsPro",
    "terms_url": "https://www.sportscardspro.com/api-documentation",
    "repository_visibility": "public",
    "public_sharing_requires_approval": true,
    "approval_env": "SPORTSCARDSPRO_COMMERCIAL_SHARING_APPROVED"
  },
  "priority_queue": {
    "source": "ops/collector/acquisition-priority-v1.json",
    "field": "tasks",
    "enabled": true,
    "max_priority_tasks": 100,
    "scheduling": "priority-first-with-fairness",
    "reserve_batch_slots": 10,
    "fallback": "existing-team-then-subject-round-robin",
    "refresh_after_each_valuation_generation": true,
    "generated_by": "scripts/generate-automated-valuation-candidates.mjs",
    "fail_closed_if_missing": true,
    "fail_closed_if_stale_hours": 24,
    "consume_only_exact_task_ids": true
  },
  "feedback_loop": {
    "enabled": true,
    "sequence": [
      "collect_exact_provider_evidence",
      "persist_observation",
      "regenerate_valuation_candidates",
      "recompute_coverage_diagnostics",
      "refresh_acquisition_priority_queue"
    ],
    "trigger_on_exact_match": true,
    "canonical_ev_promotion": "blocked-until-existing-evidence-gates-pass",
    "idempotency_key": "task_id+provider+provider_product_id+observed_at",
    "retain_previous_queue_on_refresh_failure": true,
    "qa": {
      "required_after_each_step": true,
      "current_step": 947,
      "checks": [
        "timestamps configured",
        "fail-closed semantics preserved",
        "canonical EV promotion remains gated",
        "per-step QA required"
      ]
    },
    "execution": {
      "step": 943,
      "observation_write": "atomic-before-derived-refresh",
      "valuation_refresh": "required-after-new-exact-observation",
      "coverage_refresh": "required-after-valuation-refresh",
      "priority_queue_refresh": "required-after-coverage-refresh",
      "on_stage_failure": "stop-and-retain-last-known-good-derived-state",
      "partial_promotion_allowed": false,
      "recovery": {
        "step": 944,
        "checkpoint_after": [
          "persist_observation",
          "regenerate_valuation_candidates",
          "recompute_coverage_diagnostics",
          "refresh_acquisition_priority_queue"
        ],
        "resume_from_last_successful_checkpoint": true,
        "rerun_completed_stage": false,
        "retry_failed_stage_only": true,
        "max_stage_retries": 2,
        "terminal_failure_state": "needs-review",
        "preserve_failure_reason": true
      },
      "run_identity": {
        "enabled": true,
        "format": "collector-{utc_timestamp}-{sequence}",
        "unique_per_execution": true
      },
      "stage_state": {
        "states": [
          "pending",
          "running",
          "passed",
          "failed",
          "needs-review"
        ],
        "single_active_stage": true
      },
      "timestamps": {
        "record_started_at": true,
        "record_completed_at": true,
        "utc_only": true,
        "monotonic_stage_order": true
      }
    }
  }
}
